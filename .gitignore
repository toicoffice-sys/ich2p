# Backend Apps Script source — never belongs in the publicly-deployed web root.
# This repo is pulled directly onto the ich2p.dlsl.edu.ph server; anything tracked
# here becomes browsable. Apps Script source is managed separately via clasp,
# not deployed through this repo.
apps-script/
admin-dashboard/

# Raw design source material (drafts, docs, unused assets) — not deployed
# site content. Only the specific files copied into assets/ are used live.
images/

.DS_Store

# Claude Code local settings/permissions — machine-specific, can contain
# working-tree-only entries (e.g. shell exports) never meant to leave this
# machine. Should never have been tracked in a public repo pulled onto the
# production web root.
.claude/
